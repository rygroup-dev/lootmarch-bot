# Token dari @BotFather
BOT_TOKEN=
# ID Telegram yang boleh memakai bot (cek di @userinfobot), pisahkan koma
OWNER_IDS=
# Kunci enkripsi private key & cookie (min 16 karakter). Installer membuat otomatis.
# JANGAN diganti setelah import key, kalau hilang key tersimpan tidak bisa dibuka.
SECRET_KEY=

# Opsional
# DATA_DIR=./data
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# TICK_SECONDS=300   # interval autopilot
# FEED_SECONDS=60    # interval cek feed drop
# DESKTOP_URL=https://contoh.com:6090/vnc.html   # opsional: link layar browser jarak jauh (noVNC) untuk tombol & alert live check
# Kode referral yang dipasang ke akun BARU (diisi saat install). Default bot ini: V49L3K (pembuat bot).
# Kosongkan / hapus baris ini kalau tidak mau memakai referral.
# REFERRAL_CODE=V49L3K
